# Copia este fichero a .env y rellena los valores. .env está en .gitignore: nunca subas claves.
# En Vercel van como variables de entorno del proyecto, no en .env.

# Django: 32+ caracteres aleatorios (python3 -c "import secrets; print(secrets.token_hex(32))").
# También se acepta el nombre ESTALVIA_WEB_SECRET.
SECRET_KEY=
# Código para crear una cuenta en /registro/ (se lo das a quien invitas). Vacío = registro cerrado.
# Las cuentas también se crean con: python manage.py crear_usuario nombre
ESTALVIA_CODIGO_INVITACION=
# Solo en local, para desarrollo: DEBUG=1

# Llegará con la extracción de documentos del bar
ANTHROPIC_API_KEY=
