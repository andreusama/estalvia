# Copia este fichero a .env y rellena los valores. .env está en .gitignore: nunca subas claves.
ANTHROPIC_API_KEY=
# Cadena aleatoria larga (python3 -c "import secrets; print(secrets.token_hex(32))")
ESTALVIA_MASK_KEY=

# Web local (python manage.py runserver, solo 127.0.0.1)
ESTALVIA_WEB_SECRET=
ESTALVIA_WEB_PASSWORD=
# Ruta de un CSV de consumo horario (fuera del repositorio) y su lector (fecha_hora_kwh o interno)
ESTALVIA_DATOS_CSV=
ESTALVIA_DATOS_LECTOR=fecha_hora_kwh
# Datos de la factura para la pantalla de ahorro: YAML fuera del repositorio (ver DECISIONS.md, #27)
ESTALVIA_CONTRATO=
